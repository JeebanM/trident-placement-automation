# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agent:yourpassword@localhost:5432/placement_agent

# ─── GEMINI AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── GMAIL (App Password — NOT your account password) ────────────────────────
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_SENDER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
GMAIL_RECIPIENT=recipient_email@gmail.com

# ─── SCHEDULER ───────────────────────────────────────────────────────────────
# How often to check the placement page (in minutes)
CHECK_INTERVAL_MINUTES=30

# ─── APP ─────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
